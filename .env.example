# Optional: enables live Claude-powered agent responses.
# Without it, the demo runs fully offline using grounded template responses.
ANTHROPIC_API_KEY=

# Claude model for the narrator and companion agents (PRD specifies claude-sonnet-4-6;
# a newer Sonnet such as claude-sonnet-5 can be swapped in here).
CLAUDE_MODEL=claude-sonnet-4-6

# API tier port
PORT=3001

# SQLite database file (relative to apps/api). Deleted + recreated on demo reset.
DB_PATH=connected-care.db
