{
  "name": "connected-care",
  "version": "0.1.0",
  "private": true,
  "description": "Connected Care — PetSafe multi-tier architecture demo (presentation / API / data tiers)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "seed": "npm run seed -w apps/api",
    "test": "npm run test -w apps/api",
    "build": "npm run build -w apps/web",
    "bundle:api": "esbuild apps/api/src/serverless.ts --bundle --platform=node --target=node22 --format=cjs --outfile=apps/api/dist/serverless.cjs --external:better-sqlite3 --external:swagger-ui-dist",
    "vercel-build": "npm run build && npm run bundle:api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.1"
  },
  "engines": {
    "node": "22.x"
  }
}
